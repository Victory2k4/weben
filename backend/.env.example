# Backend environment variables
# Copy file này thành .env và điền giá trị thật

# JWT Secret - đặt chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# PostgreSQL connection string từ Neon.tech
# Lấy ở: Neon Dashboard > Project > Connection Details > Connection string
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# URL của frontend sau khi deploy lên Vercel
FRONTEND_URL=https://your-app.vercel.app

# Node environment
NODE_ENV=production

# Port
PORT=3001

# Google Gemini API Key cho chức năng trợ lý AI & tạo bộ thẻ tự động
GEMINI_API_KEY=your_gemini_api_key_here
